{
  "name": "kuro-podcast-visualizer",
  "version": "1.0.0",
  "description": "Kuro Signal Protocol — Podcast Visualizer",
  "scripts": {
    "dev": "remotion studio src/Root.tsx",
    "start": "remotion studio src/Root.tsx",
    "build": "tsc --noEmit && remotion bundle src/Root.tsx build",
    "render:dialogue": "remotion render Podcast-Dialogue out/dialogue.mp4",
    "render:monologue": "remotion render Podcast-Monologue out/monologue.mp4",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.291",
    "@remotion/media-utils": "4.0.291",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.291"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@remotion/cli": "4.0.291",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
